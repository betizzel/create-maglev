      "dev.createmaglev.testing.NativeSpeedEnvelopeTests"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "1.20.1",
    "java": ">=17",
    "fabric-api": "*",
    "fabric-gametest-api-v1": "*",
    "create": ">=6.0.8",
    "create_new_age": ">=1.2.0",
    "create_maglev": "*"
  }
}
